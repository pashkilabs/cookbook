# Copy to .env.local, which is gitignored. Never commit real values.
#
# From the Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server only. Never prefixed NEXT_PUBLIC_ — that would ship it to the browser, and a
# service-role key in a bundle is every household's data (decisions §16).
SUPABASE_SERVICE_ROLE_KEY=

# The entitlement signing key (decisions §15). Generate a pair with:
#   node -e "import('@pashki/platform-client/crypto').then(m=>{const k=m.generateEd25519KeyPair();console.log(k.privateKeyPem);})"
PASHKI_TOKEN_KEY_ID=dev-1
PASHKI_TOKEN_PRIVATE_KEY=

# Development only. Issues an entitlement to a newly created household so it can write.
# NOT a trial and NOT a free tier — both are open questions in docs/decisions.md, and
# production entitlements come from a billing webhook that is blocked on Apple's
# outside-purchase rules. Ignored when NODE_ENV=production.
PASHKI_DEV_ISSUE_ENTITLEMENT=false
