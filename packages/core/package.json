{
  "name": "@pashki/core",
  "version": "0.1.0",
  "description": "Recipe domain logic: ingredient parsing, unit conversion, grocery consolidation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-fixtures": {
      "types": "./test/fixtures/catalog.ts",
      "default": "./test/fixtures/catalog.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
