{
  "name": "@pashki/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrations and generated types. Household isolation is defined here as a database guarantee, not in application code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-support": {
      "types": "./test/local-instance.ts",
      "default": "./test/local-instance.ts"
    }
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "gen:types": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "gen:seed": "tsx scripts/generate-seed.ts",
    "test": "vitest run",
    "test:mutate": "bash scripts/mutate-rls.sh",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@pashki/core": "workspace:^",
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^26.2.0",
    "supabase": "^2.113.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
