{
  "name": "@pashki/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrations and generated types. Household isolation is defined here as a database guarantee, not in application code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-support": {
      "types": "./test/support/index.ts",
      "default": "./test/support/index.ts"
    },
    "./test-support/global-setup": {
      "types": "./test/global-setup.ts",
      "default": "./test/global-setup.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    }
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "gen:types": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "check:parity": "node scripts/check-parity.mjs",
    "db:push:dry": "supabase db push --include-seed --dry-run",
    "db:push": "supabase db push --include-seed",
    "gen:seed": "tsx scripts/generate-seed.ts",
    "test": "vitest run",
    "test:mutate": "bash scripts/mutate-rls.sh",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "set:smtp": "node scripts/set-smtp.mjs",
    "set:site-url": "node scripts/set-site-url.mjs",
    "issue:entitlement": "node scripts/issue-entitlement.mjs",
    "set:drain-endpoint": "node scripts/set-drain-endpoint.mjs"
  },
  "devDependencies": {
    "@pashki/core": "workspace:^",
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^26.2.0",
    "supabase": "^2.113.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@pashki/core": "workspace:*"
  }
}
